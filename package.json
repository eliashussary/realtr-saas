{
  "name": "realtr-saas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "check:css-budgets": "node scripts/check-css-budgets.mjs",
    "check": "pnpm -r --parallel check && biome check .",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" --if-present run test:unit",
    "test:integration": "pnpm --filter @realtr/db run test:integration",
    "db:generate": "pnpm --filter @realtr/db db:generate",
    "db:migrate": "pnpm --filter @realtr/db db:migrate",
    "db:studio": "pnpm --filter @realtr/db db:studio",
    "db:seed": "pnpm --filter @realtr/db db:seed",
    "db:seed-areas": "pnpm --filter @realtr/db db:seed-areas",
    "db:push": "pnpm --filter @realtr/db db:push",
    "db:reset": "docker exec realtr-dev-db psql -U realtr -d postgres -c 'DROP DATABASE IF EXISTS realtr WITH (FORCE)' -c 'CREATE DATABASE realtr' && pnpm db:migrate && pnpm db:seed",
    "auth:generate": "pnpm --filter @realtr/app auth:generate",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
