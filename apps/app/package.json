  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-cli": "^1.167.0",
    "@types/node": "catalog:",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "nitro": "npm:nitro-nightly@latest",
