# Node image for the worker and one-shot DB migration (both run TypeScript via tsx / drizzle-kit).
FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
ENV NODE_ENV=production
# Default command is overridden per-service in docker-compose (worker vs migrate).
CMD ["pnpm", "--filter", "@realtr/worker", "start"]
