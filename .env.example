# ---- Database ----
# Local dev matches docker-compose.dev.yml
DATABASE_URL=postgres://realtr:realtr@localhost:5433/realtr
WORKER_HEALTH_PORT=3003
# Tests use this explicit, test-named database only; never point it at the development database.
TEST_DATABASE_URL=postgres://realtr_test:realtr_test@localhost:5434/realtr_test

# ---- Auth (better-auth, lives in apps/app) ----
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-change-me-please-32bytes
BETTER_AUTH_URL=http://localhost:3001

# ---- Integration credential encryption (integration.config is encrypted at rest) ----
# Generate: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=dev-only-change-me-please-32bytes

# ---- Platform super admins (comma-separated emails) ----
# Grants the cross-tenant /admin console (trigger syncs, pause/resume tenant schedules).
SUPER_ADMIN_EMAILS=elias@eliashussary.com

# ---- App URLs / ports ----
APP_URL=http://localhost:3001
RENDERER_URL=http://localhost:3000
MARKETING_URL=http://localhost:3002
# The public host tenant sites CNAME to (renderer edge), used in domain instructions.
RENDERER_BASE_HOST=sites.realtr.app
# Base host for auto-provisioned platform subdomains. Dev resolves *.localhost to 127.0.0.1;
# production sets this to the real platform host (e.g. sites.realtr.app).
PLATFORM_HOST=localhost

# ---- Uploaded assets (media library: listings, logo, blogs, agent photos) ----
# S3-compatible object storage — same code path in dev and prod. Dev runs a lightweight in-process
# S3 (s3rver, started by `pnpm dev`); prod points these at any S3-compatible endpoint
# (AWS S3, Cloudflare R2, Backblaze B2, Wasabi, …).
ASSET_S3_ENDPOINT=http://localhost:9002
ASSET_S3_BUCKET=realtr-assets
ASSET_S3_REGION=us-east-1
ASSET_S3_ACCESS_KEY_ID=realtr
ASSET_S3_SECRET_ACCESS_KEY=realtr-dev-secret
# Public URL prefix objects are served from. Defaults to <endpoint>/<bucket>; set to a CDN in prod.
# ASSET_PUBLIC_BASE=

# ---- Billing (M6) — when unset, the billing page shows "not configured" ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=            # verifies inbound Stripe webhooks (M6-A3)
# STRIPE_PRICE_SOLO=                # Stripe price id for the Solo plan
# STRIPE_PRICE_TEAM=                # Stripe price id for the Team base (5 seats)
# STRIPE_PRICE_TEAM_SEAT=           # Stripe price id for each additional Team seat
# BILLING_TRIAL_DAYS=14             # card-required trial length (default 14)
# BILLING_GRACE_DAYS=7              # payment-failure grace window before lapse (default 7, M6-A3/A4)

# ---- Deferred (not required for the thin vertical) ----
# RESEND_API_KEY=            # production magic-link email; dev logs the link to console
