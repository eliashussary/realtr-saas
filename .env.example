# ---- Database ----
# Local dev matches docker-compose.dev.yml
DATABASE_URL=postgres://realtr:realtr@localhost:5433/realtr
WORKER_HEALTH_PORT=3003
# Tests use this explicit, test-named database only; never point it at the development database.
TEST_DATABASE_URL=postgres://realtr_test:realtr_test@localhost:5434/realtr_test

# ---- Auth (better-auth, lives in apps/app) ----
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-change-me-please-32bytes
BETTER_AUTH_URL=http://localhost:3001

# ---- Integration credential encryption (integration.config is encrypted at rest) ----
# Generate: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=dev-only-change-me-please-32bytes

# ---- App URLs / ports ----
APP_URL=http://localhost:3001
RENDERER_URL=http://localhost:3000
MARKETING_URL=http://localhost:3002
# The public host tenant sites CNAME to (renderer edge), used in domain instructions.
RENDERER_BASE_HOST=sites.realtr.app

# ---- Deferred (not required for the thin vertical) ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=            # production magic-link email; dev logs the link to console
